# ============================================
# Required
# ============================================

# GitHub Personal Access Token
# Permissions required: repo, read:user
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub Username
GITHUB_USERNAME=your-username

# LLM API Key (any OpenAI-compatible provider)
# OpenAI:   https://platform.openai.com/api-keys
# New API / other proxy: use the key from your gateway
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# ============================================
# LLM Provider Settings
# ============================================

# Base URL of the OpenAI-compatible API endpoint
# OpenAI (default): https://api.openai.com/v1
# New API proxy example: https://your-new-api-host/v1
# Ollama (local):   http://localhost:11434/v1
# LiteLLM proxy:   http://localhost:4000/v1
# LLM_BASE_URL=https://api.openai.com/v1

# Model name (must match what your provider exposes)
# Examples: gpt-4o, gpt-4o-mini, deepseek-chat, claude-sonnet-4-6
# LLM_MODEL=gpt-4o-mini

# ============================================
# Category Settings
# ============================================

# Maximum number of categories (default: 32, GitHub Lists hard limit)
# MAX_CATEGORIES=32

# Maximum categories assigned per repository (default: 3)
# MAX_CATEGORIES_PER_REPO=3

# Minimum categories assigned per repository (default: 1)
# MIN_CATEGORIES_PER_REPO=1

# ============================================
# Batch Processing
# ============================================

# Number of repositories to classify per LLM call (default: 20)
# CLASSIFY_BATCH_SIZE=20

# Concurrent README fetch requests (default: 20)
# README_BATCH_SIZE=20

# Delay between GitHub List creations in ms (default: 500)
# LIST_CREATE_DELAY=500

# Delay between classification batches in ms (default: 2000)
# Increase if you hit rate limits on your LLM provider
# BATCH_DELAY=2000

# ============================================
# Rate Limiting
# ============================================

# Delay between GitHub API requests in ms (default: 100)
# GITHUB_REQUEST_DELAY=100

# ============================================
# LLM Fine-tuning
# ============================================

# Temperature for category planning (default: 0.7)
# LLM_TEMPERATURE_PLANNING=0.7

# Temperature for classification (default: 0.3)
# LLM_TEMPERATURE_CLASSIFY=0.3

# Max output tokens for planning (default: 8192)
# LLM_MAX_TOKENS_PLANNING=8192

# Max output tokens for classification (default: 8192)
# LLM_MAX_TOKENS_CLASSIFY=8192

# ============================================
# README Settings
# ============================================

# Max README length for batch classification (default: 10000)
# README_MAX_LENGTH=10000

# Max README length for single classification (default: 10000)
# README_MAX_LENGTH_SINGLE=10000

# ============================================
# List Settings
# ============================================

# Whether created Lists are private (default: false)
# LIST_IS_PRIVATE=false

# Maximum List name length (default: 20, GitHub hard limit)
# LIST_NAME_MAX_LENGTH=20

# ============================================
# Retry Settings
# ============================================

# Maximum retry attempts (default: 3)
# MAX_RETRIES=3

# Delay between retries in ms (default: 1000)
# RETRY_DELAY=1000

# ============================================
# Debug Settings
# ============================================

# Enable verbose debug logging (default: false)
# DEBUG=false

# Log full LLM API responses (default: false)
# LOG_API_RESPONSES=false
